APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://admin:admin@localhost:5432/admin?sslmode=disable

# Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=homebrew-api
JWT_AUDIENCE=admin-web
ACCESS_TTL=15m

LOG_LEVEL=info

# P0 only: static permissions for the authenticated dev principal.
# P1 replaces this with the RBAC tables. Never set this in production.
DEV_PERMISSIONS=article:read,article:write,article:publish,audit:read
