APP_ENV=development
ADMIN_DOMAIN=localhost
ADMIN_WEB_URL=http://localhost:5173
HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9090

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=admin
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_SSLMODE=disable
# Optional DSN override; when set it takes precedence over POSTGRES_* above.
# DATABASE_URL=postgres://admin:admin@localhost:5432/admin?sslmode=disable

# Redis (reserved; validates config but does not connect)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=homebrew-api
JWT_AUDIENCE=admin-web
# 8h access session; re-login after expiry
ACCESS_TTL=8h

LOG_LEVEL=info

# Used by cmd/seed only; leave empty to skip seeding.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Admin
